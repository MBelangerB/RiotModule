{
  "name": "@mbelangerb/riotmodule",
  "version": "2025.1.2",
  "description": "Bedy Riot module - Module for call Riot service and obtains information",
  "type": "module",
  "module": "build/index.js",
  "main": "build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./riotmodule": {
      "import": "./build/riotmodule.js",
      "require": "./build/riotmodule.js"
    }
  },
  "scripts": {
    "== Compile ==": "",
    "compile:npx": "npx tsc",
    "compile:rim": "rimraf ./build && tsc",
    "== NPM ==": "",
    "npm:refreshLock": "npm i --package-lock-only",
    "npm:unUsedPackage": "npm prune",
    "npm:cleanDevPackage": "npm prune --production",
    "npm:checkDependecy": "npx depcheck",
    "npm:outdated": "npm outdated",
    "== DEV ==": "",
    "start:dev": "npx nodemon",
    "start:prod": "npm run compile:npx && node build/index.js",
    "local:pack": "npm run compile:npx && npm pack",
    "== Eslint ==": "",
    "eslint": "npx eslint .",
    "eslintFix": "npx eslint . --fix",
    "== JS ==": "",
    "test:js_build": "rimraf ./build && tsc -p tsconfig-test.json",
    "test:js_run": "mocha ./build/test/*.spec.js --timeout 10000",
    "== 2025 ==": "",
    "jest:test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "jest:test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "files": [
    "build/**/*",
    "changelog.md",
    "readme.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MBelangerB/RiotModule.git"
  },
  "author": "MBelangerB",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MBelangerB/RiotModule/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/MBelangerB/RiotModule#readme",
  "dependencies": {
    "@bedy90/riotentity": "^2025.1.2",
    "axios": "^1.9.0",
    "node-cache": "^5.1.2",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.7.0",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "faker": "^5.5.3",
    "fs-extra": "^11.3.1",
    "globals": "^16.3.0",
    "jest": "^30.1.2",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.10",
    "nyc": "^15.1.0",
    "rimraf": "^5.0.10",
    "semver": "^7.7.2",
    "sinon": "^20.0.0",
    "ts-jest": "^29.4.1",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}